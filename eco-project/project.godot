; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="eco-project"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[autoload]

SceneChanger="*uid://hdkfim0n4yic"
AudioManager="*res://datas/audio/AudioManager.gd"
EcoManager="*res://systems/eco/eco_manager.gd"
InputSettings="*res://systems/input/input_settings.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[gui]

theme/custom="uid://t0jm7ccsqt58"
theme/custom_font="uid://dtkpmu4qnqb8v"

